<?xml version="1.0" encoding="utf-8"?>
<!-- প্লেয়ার বন্ধের সময়: হালকা জুম-আউট + ফেড (ছোট, যাতে ফেরার সময় ল্যাগ না লাগে) -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <scale
        android:fromXScale="1" android:toXScale="0.96"
        android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="300"
        android:interpolator="@android:interpolator/accelerate_cubic" />
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="300"
        android:interpolator="@android:interpolator/accelerate_cubic" />
</set>
