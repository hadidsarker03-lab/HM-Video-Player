<?xml version="1.0" encoding="utf-8"?>
<!-- iOS-এর মতো গ্লোসি কাচের ভাসমান ট্যাববার -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- কাচের শরীর: ওপরে উজ্জ্বল, নিচে স্বচ্ছ -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/nav_glass_top"
                android:endColor="@color/nav_glass_bottom" />
            <corners android:radius="34dp" />
            <stroke android:width="1dp" android:color="@color/nav_glass_stroke" />
        </shape>
    </item>
    <!-- ওপরের চকচকে আলোর রেখা -->
    <item
        android:bottom="42dp"
        android:left="14dp"
        android:right="14dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/nav_glass_gloss"
                android:endColor="#00FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
