<?xml version="1.0" encoding="utf-8"?>
<!-- নিচের ট্যাব: প্রতিটা আলাদা Neumorphism বোতাম; যেটায় আছি সেটা ভেতরে বসা + গ্লো -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="280"
    android:exitFadeDuration="280">
    <item android:state_checked="true">
        <inset
            android:insetLeft="24dp"
            android:insetTop="12dp"
            android:insetRight="24dp"
            android:insetBottom="12dp">
            <layer-list>
                <item android:drawable="@drawable/bg_tab_on" />
                <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
                    <shape android:shape="rectangle">
                        <gradient
                            android:centerX="0.5"
                            android:centerY="0.4"
                            android:endColor="#00000000"
                            android:gradientRadius="60%"
                            android:startColor="@color/nav_glow"
                            android:type="radial" />
                        <corners android:radius="16dp" />
                    </shape>
                </item>
            </layer-list>
        </inset>
    </item>
    <item>
        <inset
            android:insetLeft="24dp"
            android:insetTop="12dp"
            android:insetRight="24dp"
            android:insetBottom="12dp"
            android:drawable="@drawable/bg_tab" />
    </item>
</selector>
