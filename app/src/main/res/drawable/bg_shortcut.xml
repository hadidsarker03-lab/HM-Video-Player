<?xml version="1.0" encoding="utf-8"?>
<!-- প্লেয়ারের শর্টকাট আইকন: ট্রান্সপারেন্ট গ্লাস বক্স -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#245DB8FF" android:endColor="#665DB8FF" />
            <stroke android:width="1.2dp" android:color="#CC5DB8FF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#10FFFFFF" android:endColor="#42FFFFFF" />
            <stroke android:width="1dp" android:color="#73FFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
