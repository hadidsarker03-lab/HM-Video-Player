<?xml version="1.0" encoding="utf-8"?>
<!-- প্লেয়ারের শর্টকাট আইকন: স্বচ্ছ গোল, সাদা আউটলাইন; সিলেক্টেড হলে সিয়ান -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="#3300B8FF" />
            <stroke android:width="1.2dp" android:color="#FF00B8FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1.2dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
</selector>
