<?xml version="1.0" encoding="utf-8"?>
<!-- নির্বাচিত ট্যাব: ভেতরে বসা গ্লাস স্লট (স্লাইডার) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#14FFFFFF"
                android:endColor="#80FFFFFF"
                android:startColor="#4DFFFFFF" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item android:left="3.5dp" android:top="3.5dp" android:right="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/hmSurfaceAlt" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item android:left="3.5dp" android:top="3.5dp" android:right="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#1F000000"
                android:endColor="#1496BED7"
                android:startColor="#59000000" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#22000000" />
            <corners android:radius="60dp" />
        </shape>
    </item>
</layer-list>
