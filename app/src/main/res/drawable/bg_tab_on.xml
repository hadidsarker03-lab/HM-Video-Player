<?xml version="1.0" encoding="utf-8"?>
<!-- নির্বাচিত ট্যাব (XML সংস্করণ): ভেতরে বসা, ওপর-বাঁয়ে গাঢ় ছায়া -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/hmNeuDark" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/hmSurfaceAlt" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="?attr/hmNeuLight" />
            <corners android:radius="60dp" />
        </shape>
    </item>
</layer-list>
