<?xml version="1.0" encoding="utf-8"?>
<!-- নির্বাচিত ট্যাব: সমতল রং + পাতলা বর্ডার, কোনো গ্লসি ইফেক্ট নেই -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/hmSurfaceAlt" />
            <stroke android:width="1dp" android:color="?attr/hmDivider" />
            <corners android:radius="60dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp"
        android:drawable="?attr/hmFur60" />
</layer-list>
