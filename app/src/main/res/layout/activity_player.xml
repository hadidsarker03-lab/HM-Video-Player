<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ভিডিও: কন্ট্রোল প্যানেল আলাদা ভিউ, তাই প্যানেল আসা-যাওয়ায় ফ্রেম বদলায় না -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="zoom"
        app:surface_type="texture_view"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- অডিও স্ক্রিন: "Playing Now" স্টাইল -->
    <LinearLayout
        android:id="@+id/audioArt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:text="@string/playing_now"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_audio_art">

            <ImageView
                android:id="@+id/audioCover"
                android:layout_width="196dp"
                android:layout_height="196dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_audio_cover"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:padding="56dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_audio" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/audioBtnTimer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sleep_title"
                android:padding="12dp"
                android:src="@drawable/ic_timer" />

            <ImageView
                android:id="@+id/audioBtnEq"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/eq_title"
                android:padding="12dp"
                android:src="@drawable/ic_equalizer" />

            <ImageView
                android:id="@+id/audioBtnFav"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_favorite" />

            <ImageView
                android:id="@+id/audioBtnQueue"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_queue" />
        </LinearLayout>

        <TextView
            android:id="@+id/audioTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:paddingHorizontal="28dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/audioArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="28dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/audioLyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:minLines="3"
            android:paddingHorizontal="32dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ভিডিও চলছে কিন্তু শুধু অডিও মোডে: ভিনাইল ডিস্ক + বাটন -->
    <LinearLayout
        android:id="@+id/audioOnlyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/vinylDisc"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_vinyl" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:alpha="0.9"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:text="@string/audio_only_msg"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnBackToVideo"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_cyan"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:minWidth="170dp"
            android:paddingHorizontal="22dp"
            android:text="@string/btn_back_to_video"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnSaveAudio"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_cyan"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:minWidth="170dp"
            android:paddingHorizontal="22dp"
            android:text="@string/btn_save_audio"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ডান পাশের বাটন: স্ক্রিনশট, রোটেট, ম্যাজিক কাট -->
    <LinearLayout
        android:id="@+id/sideButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btnSideCut"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_side_btn"
            android:contentDescription="@string/sc_screenshot"
            android:padding="11dp"
            android:src="@drawable/ic_screenshot" />

        <ImageView
            android:id="@+id/btnSideRotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_side_btn"
            android:contentDescription="@string/desc_rotate"
            android:padding="11dp"
            android:src="@drawable/ic_rotate" />

        <FrameLayout
            android:id="@+id/btnSideMagic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_side_btn"
            android:contentDescription="@string/desc_magic_cut">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:src="@drawable/ic_magic_cut" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_new_badge"
                android:paddingHorizontal="3dp"
                android:text="@string/badge_new"
                android:textColor="#FFFFFF"
                android:textSize="7sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- নাইট মোড: পর্দা ম্লান করার স্তর -->
    <View
        android:id="@+id/nightOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_player_top"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_back"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/videoTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btnHdr"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_hdr">

                <TextView
                    android:id="@+id/hdrText"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_hdr_label"
                    android:gravity="center"
                    android:paddingHorizontal="5dp"
                    android:text="HDR"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_new_badge"
                    android:paddingHorizontal="3dp"
                    android:text="@string/badge_new"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnSubtitle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_subtitle"
                android:padding="10dp"
                android:src="@drawable/ic_subtitles" />

            <ImageView
                android:id="@+id/btnAudioTrack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_audio_only"
                android:padding="10dp"
                android:src="@drawable/ic_headset" />

            <ImageView
                android:id="@+id/btnQueueTop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/p_queue"
                android:padding="10dp"
                android:src="@drawable/ic_queue" />

            <TextView
                android:id="@+id/hwLabel"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_player_label"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="HW"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_more"
                android:padding="10dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/shortcutScroll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/shortcutRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/posText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="?attr/colorPrimary"
                android:secondaryProgressTint="#88FFFFFF"
                android:thumbTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/durText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnLock"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_lock"
                android:padding="12dp"
                android:src="@drawable/ic_unlock" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnPrev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_prev"
                    android:padding="10dp"
                    android:src="@drawable/ic_prev" />

                <ImageView
                    android:id="@+id/btnPlay"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginHorizontal="18dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_play"
                    android:padding="10dp"
                    android:src="@drawable/ic_pause" />

                <ImageView
                    android:id="@+id/btnNext"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_next"
                    android:padding="10dp"
                    android:src="@drawable/ic_next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAspect"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_frame"
                    android:padding="12dp"
                    android:src="@drawable/ic_aspect" />

                <ImageView
                    android:id="@+id/btnPip"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_pip"
                    android:padding="12dp"
                    android:src="@drawable/ic_pip" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- লক অবস্থায় শুধু এই বাটন দেখা যায় -->
    <ImageView
        android:id="@+id/btnUnlock"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="start|bottom"
        android:layout_margin="20dp"
        android:background="@drawable/bg_badge"
        android:contentDescription="@string/desc_lock"
        android:padding="14dp"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />

    <!-- ডান পাশের "আরও" প্যানেল -->
    <ScrollView
        android:id="@+id/morePanel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_side_panel"
        android:clickable="true"
        android:focusable="true"
        android:overScrollMode="never"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/morePanelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <!-- ভলিউম (ডানে) ও ব্রাইটনেস (বামে) স্লাইডার-পিল -->
    <com.example.videoplayer.LevelPill
        android:id="@+id/volumePill"
        android:layout_width="64dp"
        android:layout_height="190dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="28dp"
        android:visibility="gone" />

    <com.example.videoplayer.LevelPill
        android:id="@+id/brightPill"
        android:layout_width="64dp"
        android:layout_height="190dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="28dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/feedbackBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="22dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/feedbackIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
