<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- সাধারণ (অপাক) থিম -->
    <style name="Theme.HMPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSecondaryContainer">@color/surface_alt</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurfaceContainer">@color/dialog_bg</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- Android 15 (targetSdk 35): জোর করে edge-to-edge চালু হওয়া বন্ধ রাখে, UI আগের মতোই থাকে -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="hmBg">@color/bg</item>
        <item name="hmText">@color/text_primary</item>
        <item name="hmTextSecondary">@color/text_secondary</item>
        <item name="hmSurface">@color/surface</item>
        <item name="hmSurfaceAlt">@color/surface_alt</item>
        <item name="hmDivider">@color/divider</item>
        <item name="hmNeuLight">@color/neu_light</item>
        <item name="hmNeuDark">@color/neu_dark</item>
        <item name="android:windowAnimationStyle">@style/HMWindowAnim</item>
        <item name="hmFur10">@android:color/transparent</item>
        <item name="hmFur14">@android:color/transparent</item>
        <item name="hmFur16">@android:color/transparent</item>
        <item name="hmFur20">@android:color/transparent</item>
        <item name="hmFur22">@android:color/transparent</item>
        <item name="hmFur60">@android:color/transparent</item>
        <item name="hmFurOn60">@android:color/transparent</item>
    </style>

    <!-- ট্রান্সপারেন্ট (গ্লাস) থিম: ওয়ালপেপার দেখা যায়, সিস্টেম বার স্বচ্ছ -->
    <style name="Theme.HMPlayer.Glass">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@color/glass_window</item>
        <item name="android:colorBackground">@color/glass_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="hmBg">@android:color/transparent</item>
        <item name="hmSurface">@color/glass_surface</item>
        <item name="hmSurfaceAlt">@color/glass_surface_alt</item>
        <item name="hmDivider">@color/glass_divider</item>
        <item name="hmNeuLight">@android:color/transparent</item>
        <item name="hmNeuDark">@android:color/transparent</item>
    </style>


    <!-- ফার (প্লাশ) থিম: কালো পশমি টেক্সচার, নরম ফোলা বোতাম -->
    <style name="Theme.HMPlayer.Fur">
        <item name="colorPrimary">#E6E6EA</item>
        <item name="colorOnPrimary">#121214</item>
        <item name="colorSurface">#121213</item>
        <item name="colorOnSurface">#E8E8EC</item>
        <item name="colorSecondaryContainer">#1A1A1C</item>
        <item name="colorOnSecondaryContainer">#E8E8EC</item>
        <item name="colorSurfaceContainer">#161617</item>
        <item name="colorSurfaceContainerHigh">#161617</item>
        <item name="android:colorBackground">#0B0B0C</item>
        <item name="android:windowBackground">#0B0B0C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="hmBg">@android:color/transparent</item>
        <item name="hmText">#E8E8EC</item>
        <item name="hmTextSecondary">#9C9CA4</item>
        <item name="hmSurface">@android:color/transparent</item>
        <item name="hmSurfaceAlt">@android:color/transparent</item>
        <item name="hmDivider">@android:color/transparent</item>
        <item name="hmNeuLight">@android:color/transparent</item>
        <item name="hmNeuDark">@android:color/transparent</item>
        <item name="hmFur10">@drawable/fur_r10</item>
        <item name="hmFur14">@drawable/fur_r14</item>
        <item name="hmFur16">@drawable/fur_r16</item>
        <item name="hmFur20">@drawable/fur_r20</item>
        <item name="hmFur22">@drawable/fur_r22</item>
        <item name="hmFur60">@drawable/fur_r60</item>
        <item name="hmFurOn60">@drawable/fur_on60</item>
    </style>

    <!-- সাধারণ মোডে ওয়ালপেপার বসালে: সব বক্স/কার্ড/বর্ডার/ছায়া পুরো স্বচ্ছ, শুধু লেখা ও আইকন দেখা যায় -->
    <style name="WallpaperOverlay">
        <item name="hmBg">@android:color/transparent</item>
        <item name="hmSurface">@android:color/transparent</item>
        <item name="hmSurfaceAlt">@android:color/transparent</item>
        <item name="hmDivider">@android:color/transparent</item>
        <item name="hmNeuLight">@android:color/transparent</item>
        <item name="hmNeuDark">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- গাঢ় ছবির ওপর সাদা লেখা -->
    <style name="WallpaperTextOnDark">
        <item name="hmText">#FFFFFF</item>
        <item name="hmTextSecondary">#D9FFFFFF</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorSurface">#FF1E2026</item>
        <item name="colorSurfaceContainer">#FF262A31</item>
        <item name="colorSurfaceContainerHigh">#FF262A31</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- হালকা ছবির ওপর গাঢ় লেখা -->
    <style name="WallpaperTextOnLight">
        <item name="hmText">#15171C</item>
        <item name="hmTextSecondary">#B315171C</item>
        <item name="colorOnSurface">#15171C</item>
        <item name="colorOnSecondaryContainer">#15171C</item>
        <item name="colorSurface">#FFF4F6FA</item>
        <item name="colorSurfaceContainer">#FFEDEFF4</item>
        <item name="colorSurfaceContainerHigh">#FFEDEFF4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- প্লেয়ার পেজ: কালো ব্যাকগ্রাউন্ড, সিস্টেম বার স্বচ্ছ -->
    <style name="Theme.HMPlayer.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@style/HMPlayerWindowAnim</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- অ্যাপ চালুর স্ক্রিন (স্প্ল্যাশ) -->
    <style name="Theme.HMPlayer.Starting">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>


    <!-- স্ক্রিন খোলা/বন্ধের স্মুথ স্লাইড + ফেড -->
    <!-- প্লেয়ার স্ক্রিন: জুম-ইন/আউট -->
    <style name="HMPlayerWindowAnim" parent="HMWindowAnim">
        <item name="android:activityOpenEnterAnimation">@anim/hm_zoom_in</item>
        <item name="android:activityCloseExitAnimation">@anim/hm_zoom_out</item>
    </style>

    <style name="HMWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/hm_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/hm_exit_back</item>
        <item name="android:activityCloseEnterAnimation">@anim/hm_enter_back</item>
        <item name="android:activityCloseExitAnimation">@anim/hm_exit</item>
    </style>

